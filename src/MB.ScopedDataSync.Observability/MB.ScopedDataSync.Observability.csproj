<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Métricas e tracing opcionais de staleness, falhas de sync e eventos aplicados ou descartados. O pacote traz dashboard Grafana e regras Prometheus; o exporter fica no host.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MB.ScopedDataSync.Abstractions\MB.ScopedDataSync.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <None Update="dashboards\grafana-scoped-data-sync.json" Pack="true" PackagePath="dashboards\grafana-scoped-data-sync.json" />
    <None Update="alerts\prometheus-scoped-data-sync.yml" Pack="true" PackagePath="alerts\prometheus-scoped-data-sync.yml" />
  </ItemGroup>
</Project>
